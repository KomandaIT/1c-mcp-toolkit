# 1C MCP Toolkit Proxy — пример конфигурации.
#
# Скопируйте в .env: cp .env.example .env
# docker-compose подхватывает .env автоматически (env_file), значения ниже —
# те же дефолты, что зашиты в compose. Всё опционально: без .env прокси
# запускается с настройками по умолчанию.

# --- Базовые ---
# Порт HTTP-сервера.
PORT=6003
# Таймаут ожидания ответа 1С, сек.
TIMEOUT=180
# Таймаут long-poll /1c/poll (0 = платформенный дефолт).
POLL_TIMEOUT=0
# Уровень логирования: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
# Режим разработки (auto-reload).
DEBUG=false
# Режим подтверждения опасных операций (иначе — жёсткая блокировка).
ALLOW_DANGEROUS_WITH_APPROVAL=true
# Формат ответов: toon (компактный) или json.
RESPONSE_FORMAT=toon
# Автоопределение кодировки не-UTF-8 запросов (CP1251/CP866 от Windows-клиентов).
ENABLE_ENCODING_AUTO_DETECTION=true

# --- Опасные ключевые слова execute_code (через запятую; не задано — дефолтный список) ---
# DANGEROUS_KEYWORDS=

# --- Анонимизация ---
# Автоматическое маскирование ПДн в ответах 1С (токены вида [ORG-00001]).
ANONYMIZATION_ENABLED=false
# Токенизировать все строки, а не только детектированные чувствительные.
ANONYMIZATION_RADICAL_MODE=false
# Natasha NER (лица/организации/адреса из текста).
ANONYMIZATION_NER_ENABLED=false
# NER внутри результатов execute_code и в сообщениях об ошибках.
ANONYMIZATION_NER_FOR_EXECUTE_CODE_RESULT=false
ANONYMIZATION_NER_FOR_ERROR=false
# Маскирование сообщений об ошибках.
ANONYMIZATION_INCLUDE_ERRORS=true
# Словарное маскирование (значения из справочников 1С).
ANONYMIZATION_DICTIONARY_ENABLED=true
# Дисковый кэш словаря (TTL сек, каталог кэша).
ANONYMIZATION_DICTIONARY_CACHE_ENABLED=true
ANONYMIZATION_DICTIONARY_CACHE_TTL=14400
ANONYMIZATION_DICTIONARY_CACHE_DIR=.dict_cache
# Максимум строк на источник при префетче словаря.
ANONYMIZATION_DICTIONARY_PRELOAD_LIMIT=50000
# Soft cap карты токенов на канал (0 = без ограничения).
ANONYMIZATION_TOKENMAP_MAX=10000
# Белый список инструментов, подлежащих анонимизации (не задано — дефолтный).
# ANONYMIZATION_TOOLS=

# --- Корпус для дообучения маскирования ---
# Собирает raw-ответы инструментов 1С (ДО анонимизации, без аргументов) в
# JSONL-файлы — данные для дообучения/калибровки маскирования ПДн.
# ВНИМАНИЕ: raw-ответы содержат персональные данные. Каталог корпуса имеет
# права 0700 и не публикуется наружу; ретеншн по умолчанию 30 дней.
# Redis недоступен → записи пропускаются (fail-open, ответы не ломаются).
CORPUS_ENABLED=true
# Очередь записей (переживает рестарты). Дефолт указывает на redis-сервис compose.
CORPUS_REDIS_URL=redis://redis:6379/2
# Каталог JSONL-файлов (volume toolkit-corpus в compose).
CORPUS_DIR=/app/corpus
# Периодичность flush Redis → JSONL, сек.
CORPUS_FLUSH_INTERVAL_SEC=3600
# Лимит размера записи (байты, свыше — обрезка с truncated: true).
CORPUS_MAX_RECORD_BYTES=1048576
# Потолок очереди Redis (при превышении — пропуск с warning).
CORPUS_REDIS_MAX_RECORDS=100000
# Удаление JSONL-файлов старше N дней.
CORPUS_RETENTION_DAYS=30
# Инструменты, никогда не попадающие в корпус (скриншоты — base64, деанонимизация).
CORPUS_EXCLUDE_TOOLS=submit_for_deanonymization,get_screenshot

# --- Admin UI корпуса (http://<host>:6003/admin/corpus) ---
# ОБЯЗАТЕЛЬНО смените дефолтные креды перед прод-запуском!
CORPUS_ADMIN_EMAIL=admin@toolkit.local
CORPUS_ADMIN_PASSWORD=change-me-corpus-admin
# TTL session-cookie, сек (12ч).
CORPUS_ADMIN_SESSION_TTL=43200
# Секрет подписи cookie. Пусто = эфемерный ключ (каждый рестарт прокси
# разлогинивает администратора). Задайте постоянное значение в проде.
CORPUS_ADMIN_SESSION_SECRET=
